
{
  "name": "skillbridge-campus-freelancing",
  "version": "1.0.0",
  "description": "Smart Campus Freelancing Hub for Students - React Native & Node.js Platform",
  "main": "index.js",
  "scripts": {
    "setup": "./dev-setup.sh",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "cd ../backend && npm run dev",
    "dev:frontend": "cd ../smarthub-fresh && npm start",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:backend": "cd ../backend && npm run lint",
    "lint:frontend": "cd ../smarthub-fresh && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yourusername/smarthub-campus-freelancing.git"
  },
  "keywords": [
    "freelancing",
    "campus",
    "students",
    "react-native",
    "nodejs",
    "ai-matching",
    "education-technology"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
