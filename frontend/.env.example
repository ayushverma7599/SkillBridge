# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WEBSOCKET_URL=ws://localhost:3000

# Firebase Configuration
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id

# Payment Configuration
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
EXPO_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id

# App Configuration
EXPO_PUBLIC_APP_NAME=SmartHub
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_ENVIRONMENT=development

# External Services
EXPO_PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id
EXPO_PUBLIC_UNIVERSITY_API_BASE=https://university-api.example.com

# Feature Flags
EXPO_PUBLIC_ENABLE_AI_MATCHING=true
EXPO_PUBLIC_ENABLE_PEER_COLLABORATION=true
EXPO_PUBLIC_ENABLE_PAYMENT_GATEWAY=true
