# Copy this file to .env and adjust for your setup.
#
# Base URL of the backend API (see ../backend). When running the web export
# locally against a locally-running backend, http://localhost:5000/api/v1 is
# correct. When testing on a physical phone with Expo Go, use your computer's
# LAN IP instead of localhost (phones can't resolve "localhost" to your PC).
EXPO_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
